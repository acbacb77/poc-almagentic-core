digraph arquitectura {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.6, bgcolor="white", pad=0.2];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#5b6964", fillcolor="#ffffff", penwidth=1.2];
  edge  [fontname="Helvetica", fontsize=9, color="#5b6964"];

  subgraph cluster_local {
    label="Puesto local (Windows + WSL + Docker Desktop)"; style="rounded,dashed"; color="#9aa7a2"; fontcolor="#3a4642";
    dev    [label="Devcontainer\nClaude Code + harness\n(7 capas)", fillcolor="#dff0ec"];
    k8s    [label="Kubernetes local\nArgo CD\n(staging)", fillcolor="#e3ebf6"];
  }

  subgraph cluster_gh {
    label="GitHub (repos públicos)"; style="rounded"; color="#9aa7a2"; fontcolor="#3a4642";
    app    [label="poc-almagentic-app\ncódigo · specs · harness", fillcolor="#fdf0d9"];
    core   [label="poc-almagentic-core\nworkflows · agent-standards\n(solo humanos)", fillcolor="#f0e8fa"];
    gitops [label="poc-almagentic-gitops\nestado deseado del cluster", fillcolor="#e3ebf6"];
    actions[label="GitHub Actions\ntriage · CI · seguridad\npromoción", fillcolor="#ffffff"];
  }

  humano [label="Responsable humano\naprueba PRs y promociones", shape=ellipse, fillcolor="#fbe9dc"];

  dev -> app      [label="PR como almagentic-agent[bot]\n(token de 1 h)"];
  app -> actions  [label="eventos"];
  actions -> core [label="workflows reutilizables @v1", style=dashed, dir=back];
  actions -> gitops [label="PR de promoción\n(almagentic-promoter)"];
  k8s -> gitops   [label="Argo CD lee (pull)", style=dashed];
  humano -> app   [label="aprueba"];
  humano -> gitops[label="aprueba = despliega"];
}

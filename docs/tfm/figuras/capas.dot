digraph capas {
  graph [rankdir=TB, fontname="Helvetica", fontsize=11, nodesep=0.2, ranksep=0.12, bgcolor="white", pad=0.2];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, width=5.6, color="#5b6964", penwidth=1.1];
  edge  [style=invis];

  c1 [label="1 · Contexto (AGENTS.md / CLAUDE.md): cómo trabajar; el contenido externo son datos", fillcolor="#ffffff"];
  c2 [label="2 · Constitución: principios que Spec Kit aplica a cada spec", fillcolor="#f7f9f8"];
  c3 [label="3 · Permisos (settings.json): permitido, pregunta o prohibido", fillcolor="#eef3f1"];
  c4 [label="4 · Hook guard.py: analiza cada subcomando y registra cada bloqueo", fillcolor="#e3eeea"];
  c5 [label="5 · Sandbox: el sistema operativo limita la red y la lectura de secretos", fillcolor="#d6e8e2"];
  c6 [label="6 · Identidad (GitHub App): token de 1 h, un repo, sin permiso Workflows", fillcolor="#c4ddd5", fontcolor="#0b3d33"];
  c7 [label="7 · Plataforma (CODEOWNERS + ruleset): PR obligatorio y aprobación humana", fillcolor="#a9cfc3", fontcolor="#0b3d33"];
  c1 -> c2 -> c3 -> c4 -> c5 -> c6 -> c7;
}
